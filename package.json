{
  "name": "bun-typescript-docker-starter",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun run dist/index.js",
    "build": "bun scripts/build.ts",
    "build:spa": "bun scripts/build.ts --spa",
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "dev:spa": "bun --watch scripts/dev-spa.ts",
    "verify": "bun scripts/verify.ts",
    "check": "bun check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "prepare": "husky",
    "create": "bun scripts/create.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "solid-js": "^1.9.17"
  }
}
