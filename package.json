{
  "name": "bun-typescript-docker-starter",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir dist --target bun --env disable",
    "test": "bun test",
    "dev": "bun run --watch src/index.ts",
    "check": "bun check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "prepare": "husky",
    "create": "bun scripts/create.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
